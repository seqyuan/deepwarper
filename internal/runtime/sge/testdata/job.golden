#!/bin/bash
#$ -S /bin/bash
# generated by dw; regenerated on every start, edits are overwritten.
set -uo pipefail

RD='/data/dw/control/alice-default'
INC='inc-7f3a1c2e'
mkdir -p "$RD"
_pub() { local f="$RD/$1.tmp"; printf '%s\n' "$2" >"$f" && mv "$f" "$RD/$1"; }
trap '_pub state failed; _pub exit_code 143' TERM INT

# The shared filesystem is the control channel: the login node reads these.
_pub incarnation "$INC"
_pub state starting
_pub node "$(hostname)"
_pub jobid "${JOB_ID:-}"
_pub pid "$$"

# The container runtime is installed on compute nodes, not on the login node.
DW_BOX="$(command -v apptainer || command -v singularity || true)"
if [ -z "$DW_BOX" ]; then
  _pub state failed; _pub exit_code 1
  echo "dw: neither apptainer nor singularity on $(hostname)" >&2
  exit 1
fi
SIF='/data/dw/images/dw-runtime.sif'
if [ ! -r "$SIF" ]; then
  _pub state failed; _pub exit_code 1
  echo "dw: image not readable on $(hostname): $SIF" >&2
  exit 1
fi

"$DW_BOX" exec --containall --cleanenv --no-home \
  --home '/home/dsh' --pwd '/workspace' \
  --bind '/data/dw/homes/alice:/home/dsh:rw' \
  --bind '/data/dw/workspaces/alice:/workspace:rw' \
  --bind '/data/dw/dist/default/1.0.0:/data/dw/dist/default/1.0.0:ro' \
  --bind '/data/dw/control/alice-default:/data/dw/control/alice-default:rw' \
  "$SIF" \
  '/usr/local/bin/dw' instance --spec '/data/dw/control/alice-default/spec.json'

_code=$?
_pub state exited
_pub exit_code "$_code"
exit "$_code"
